# Sunshine Coast Oral, Facial & Implant Specialists: environment variables.
# Copy to .env.local for local work. On Vercel, add these under Settings > Environment Variables.
# Never commit real values. See README-CMS.md for what each one does and where it comes from.

# ---- Dashboard (required on Vercel for /admin to work) ----
# Neon Postgres connection string (Vercel > Storage > Neon, or neon.tech > Connection details, pooled).
DATABASE_URL=
# Long random string that signs dashboard sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Vercel Blob read/write token (Vercel > Storage > Blob). Without it, uploads go to a local folder that Vercel does not keep.
BLOB_READ_WRITE_TOKEN=
# Vercel deploy hook for the production branch (Vercel > Settings > Git > Deploy Hooks). Fired by "Publish website".
PUBLISH_HOOK_URL=
# Full site address, no trailing slash. Production: https://sunshinecoastofis.com.au
NEXT_PUBLIC_SERVER_URL=https://sunshinecoastofis.com.au

# ---- Website forms ----
# SMTP2GO API key (SMTP2GO > Sending > API Keys). Required for form emails.
SMTP2GO_API_KEY=
# Form email recipients are set in lib/forms/recipients.ts (3.6.1), not here:
# website forms -> reception@sunshinecoastofis.com.au; landing pages -> reception + rowayne@gyaclients.com.
# FORM_TO, FORM_CC, FORM_BCC and NOTIFY_TO are no longer read.
# Sender on an SMTP2GO verified domain, e.g. Sunshine Coast OFIS Website <noreply@sunshinecoastofis.com.au>
FORM_FROM=

# ---- SmileOX CRM (ONLY the two /lp landing pages create a lead; the website's own forms never do) ----
# See README_CRM.md. With SMTP_HOST/SMTP_USER/SMTP_PASS empty, leads are sent through SMTP2GO_API_KEY above.
# SMTP server with TLS. Port 465 (or 8465/443) = implicit TLS; 587/2525 = STARTTLS, which is then required.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: force implicit TLS on or off (true/false) when the port is not one of the above.
SMTP_SECURE=
# Sender over SMTP, on a domain verified with the SMTP provider, e.g. no-reply@sunshinecoastofis.com.au
# MAIL_FROM (the landing pages' name for it) wins over SMTP_FROM; set one. Empty: FORM_FROM is used.
# Not used by the SMTP2GO API fallback, which always sends from FORM_FROM.
MAIL_FROM=
SMTP_FROM=
# SmileOX intake address. Empty: the practice's intake address built into the code. "off" stops sending leads.
# LEAD_INTAKE (the landing pages' name for it) wins over CRM_INTAKE_EMAIL; set one.
LEAD_INTAKE=
CRM_INTAKE_EMAIL=contact-submissions+50d8ee08-b736-4740-a84b-ae94788ca250@intake.smileox.com.au

# ---- One-off setup (leave empty normally) ----
# true only while creating the very first dashboard account at /cms on a new database, then delete it.
ALLOW_FIRST_USER=
# Sign-in rescue: when the email and password typed on /admin match these, that account is created or reset as admin.
# Delete ADMIN_PASSWORD (and redeploy) as soon as you have signed in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Local testing only (never set on Vercel) ----
# Extra host names to treat as the live site (no "noindex" header), e.g. localhost for a Lighthouse run.
EXTRA_LIVE_HOSTS=
